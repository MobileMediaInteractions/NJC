{
  "expo": {
    "name": "The New Jersey Courier",
    "slug": "new-jersey-courier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/courier-icon.png",
    "scheme": "njcourier",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/courier-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.mobilemediainteractions.thenews",
      "buildNumber": "1",
      "associatedDomains": ["applinks:www.thejerseycourier.com"],
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["njcourier-employee"]
      }
    },
    "android": {
      "package": "com.mobilemediainteractions.thenews",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#173E32",
        "foregroundImage": "./assets/images/courier-android-foreground.png",
        "monochromeImage": "./assets/images/courier-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "www.thejerseycourier.com", "pathPrefix": "/story/" },
            { "scheme": "https", "host": "www.thejerseycourier.com", "path": "/latest" },
            { "scheme": "https", "host": "www.thejerseycourier.com", "path": "/weather" },
            { "scheme": "https", "host": "www.thejerseycourier.com", "path": "/watch" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/courier-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173E32",
          "image": "./assets/images/courier-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C49545",
          "defaultChannel": "breaking-news"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow The New Jersey Courier to scan secure sign-in QR codes",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://www.thejerseycourier.com"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
