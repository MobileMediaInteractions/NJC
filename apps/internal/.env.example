# The app must remain disabled until the Cloudflare Access + mTLS perimeter is
# deployed and independently tested. Do not expose it with only these settings.
INTERNAL_HOST_ENABLED=false
INTERNAL_HOST=int.thejerseycourier.com

# Cloudflare Access JWT verification. The audience is the Access application
# AUD tag, not a hostname. The team domain excludes https:// and trailing slash.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=

# A random value of at least 32 characters. Configure Cloudflare to replace
# X-NJC-Internal-Origin on origin requests; never expose this value to clients.
# It prevents an Access JWT from being replayed against a raw Vercel origin.
INTERNAL_ORIGIN_SECRET=

# Shared identity and least-privilege data access. Use a separate database role
# and Clerk key allocation for the internal deployment in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
