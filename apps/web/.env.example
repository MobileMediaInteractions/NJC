# Public configuration
# Leave blank locally to use the automatic localhost/Vercel origin.
# Production uses the canonical public domain.
NEXT_PUBLIC_SITE_URL=
# Public subdomain routing. The defaults are the Courier production hosts.
NEXT_PUBLIC_STUDIO_URL=https://studio.thejerseycourier.com
NEXT_PUBLIC_STUDIO_HOST=studio.thejerseycourier.com
NEXT_PUBLIC_API_HOST=api.thejerseycourier.com
NEXT_PUBLIC_PLUS_HOST=plus.thejerseycourier.com
NEXT_PUBLIC_COURIER_CUT_HOST=cut.thejerseycourier.com
NEXT_PUBLIC_DISTRIBUTION_HOST=distribution.thejerseycourier.com
NEXT_PUBLIC_DISTRIBUTION_URL=https://distribution.thejerseycourier.com
NEXT_PUBLIC_LINKS_HOST=links.thejerseycourier.com
NEXT_PUBLIC_LINKS_URL=https://links.thejerseycourier.com
NEXT_PUBLIC_PRESS_HOST=press.thejerseycourier.com
NEXT_PUBLIC_PRESS_URL=https://press.thejerseycourier.com
# Keep false until the Press hostname resolves and SSL/readiness checks pass.
PRESS_SUBDOMAIN_ENABLED=false

# Locked Studio domain-control center. Keep disabled until all values are set.
# Operator IDs are exact Clerk user IDs; administrator role alone is insufficient.
DOMAIN_CONTROL_ENABLED=false
DOMAIN_CONTROL_OPERATOR_CLERK_IDS=
# Random 32+ character HMAC key for five-minute, actor/hostname-bound previews.
DOMAIN_CONTROL_CHALLENGE_SECRET=
# Use a scoped, expiring Vercel access token fixed to this project and team.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Optional full DNS automation through an IONOS Cloud DNS zone. Without these,
# Studio attaches Vercel and returns the exact CNAME for manual provider entry.
IONOS_DNS_API_TOKEN=
IONOS_DNS_ZONE_ID=
IONOS_DNS_API_URL=https://dns.de-fra.ionos.com
# Fail-closed release switch. Enable only after database migration, private Blob,
# Clerk custom-domain authorization, and DNS are verified.
DISTRIBUTION_ENABLED=false
# Leave blank to serve /assets from the web deployment. Production uses the CDN.
NEXT_PUBLIC_ASSET_ORIGIN=
# Keep false until legal, editorial, and operational launch review is complete.
NEXT_PUBLIC_SEO_INDEXING_ENABLED=false
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Neon Postgres (install Neon from the Vercel Marketplace)
DATABASE_URL=
ANALYTICS_V2_BASELINE_APPROVED=false

# Clerk (install Clerk from the Vercel Marketplace)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Developer API key HMAC pepper (generate 32+ random bytes) and Upstash limits.
# Vercel Marketplace currently provides KV_REST_API_*; legacy Upstash names remain supported.
API_KEY_PEPPER=
DEVICE_PAIRING_PEPPER=
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public press-kit contact shown inside generated archives.
# The generator uses Upstash above for a durable 3-per-hour requester limit.
PRESS_CONTACT_EMAIL=
# Separate HMAC pepper for request and package credentials (32+ random bytes).
PRESS_KIT_TOKEN_PEPPER=
# Transactional status sender on a verified domain, for example:
# The New Jersey Courier Press <press@thejerseycourier.com>
PRESS_EMAIL_FROM=
# Exact version acknowledgements recorded only after qualified review. These
# are readiness evidence; they do not grant new rights or replace source text.
PRESS_LEGAL_APPROVED_POLICY_VERSION=
PRESS_LEGAL_APPROVED_LICENSE_VERSION=
PRESS_LEGAL_ENTITY_NAME=
PRESS_LEGAL_JURISDICTION=
PRESS_REQUEST_RETENTION_DAYS=

# Vercel Blob. Keep published media and privileged exports/attachments in separate stores.
BLOB_READ_WRITE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_TOKEN=
CLOUDFLARE_AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_AI_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
PRIVATE_BLOB_READ_WRITE_TOKEN=
CRON_SECRET=

# NJC+ commerce. Leave blank until legal/commercial approval and test-mode setup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
NJC_PLUS_INVITED_BETA_LIMIT=10

# Optional public runtime metadata and National Weather Service identification.
NEXT_PUBLIC_APP_VERSION=
NWS_USER_AGENT=

# Public presentation. Studio stores the release state in site configuration.
# The server-only override is intended for isolated preview/staging deployments.
# Omit it in ordinary production so Studio remains authoritative.
SITE_DESIGN_OVERRIDE=
# Optional dedicated signer; Clerk's server secret is used when this is blank.
SITE_DESIGN_PREVIEW_SECRET=

# Website notifications use standard VAPID Web Push. Generate a key pair once,
# keep the private key server-only, and use a monitored mailto: or https: contact.
NEXT_PUBLIC_WEB_PUSH_VAPID_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=

# Expo mobile/TV local development. Store builds should use the web project's *.vercel.app URL.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_TV_API_URL=http://localhost:3000
EXPO_ACCESS_TOKEN=

# Public reader-app Universal Links/App Links. Values come from the signed
# Apple/Android release identities; do not invent certificates or team IDs.
# iOS format: TEAM_ID.com.mobilemediainteractions.thenews
READER_IOS_APP_ID=
READER_ANDROID_PACKAGE=com.mobilemediainteractions.thenews
# Comma-separated release-certificate SHA-256 fingerprints.
READER_ANDROID_SHA256_CERT_FINGERPRINTS=

# Dedicated employee app. Use the Vercel *.vercel.app host until a custom domain exists.
EXPO_PUBLIC_EMPLOYEE_API_URL=http://localhost:3000
EXPO_PUBLIC_EMPLOYEE_LINK_HOST=
EXPO_PUBLIC_EMPLOYEE_EAS_PROJECT_ID=
# Server-controlled compatibility and approved distribution destinations. Do not invent store URLs.
EMPLOYEE_MIN_APP_VERSION=1.0.0
EMPLOYEE_IOS_INSTALL_URL=
EMPLOYEE_ANDROID_INSTALL_URL=
EMPLOYEE_INTERNAL_INSTALL_URL=
# Required only when enabling Universal Links/App Links for a deployed host.
# iOS format: TEAM_ID.com.mobilemediainteractions.thenews.employee
EMPLOYEE_IOS_APP_ID=
EMPLOYEE_ANDROID_PACKAGE=com.mobilemediainteractions.thenews.employee
# Comma-separated release-certificate SHA-256 fingerprints.
EMPLOYEE_ANDROID_SHA256_CERT_FINGERPRINTS=

# Studio export safety cap (bytes in a server function)
BACKUP_MAX_BYTES=100000000

# Feature-platform licensing. Generate an Ed25519 key pair; keep the private key only in Vercel secrets.
PLATFORM_LICENSE_ISSUER=
PLATFORM_LICENSE_AUDIENCE=platform-runtime
PLATFORM_LICENSE_KEY_ID=
PLATFORM_ED25519_PRIVATE_KEY_PEM=
PLATFORM_ED25519_PUBLIC_KEY_PEM=
# JSON array of retired public SigningKeyRecord objects retained to verify unexpired receipts.
PLATFORM_ED25519_PREVIOUS_PUBLIC_KEYS_JSON=
PLATFORM_LICENSE_KEY_PEPPER=
PLATFORM_INSTALLATION_PEPPER=

# Optional integrations
RESEND_API_KEY=
NEWSLETTER_WEBHOOK_URL=
